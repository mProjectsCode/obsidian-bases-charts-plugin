{
	"name": "bases-charts",
	"version": "0.0.12",
	"description": "",
	"main": "main.js",
	"scripts": {
		"dev": "vite build --mode=development --watch",
		"build": "vite build --mode=production",
		"tsc": "bun run typecheck",
		"test": "bun test",
		"test:log": "LOG_TESTS=true bun test",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint . --report-unused-disable-directives --suppressions-location eslint-ci-suppressions.json",
		"lint:fix": "eslint . --fix --report-unused-disable-directives --suppressions-location eslint-ci-suppressions.json",
		"svelte-check": "svelte-check --compiler-warnings \"unused-export-let:ignore\"",
		"check": "bun run format:check && bun run typecheck && bun run typecheck:tools && bun run svelte-check && bun run lint && bun run test",
		"release": "lemons-automation release",
		"typecheck": "tsc -noEmit -skipLibCheck",
		"lint:review": "eslint . --config eslint.review.config.mjs",
		"verify": "bun run check && bun run build && lemons-automation validate",
		"package": "bun run build && lemons-automation package",
		"typecheck:tools": "tsc --noEmit -p tsconfig.tools.json"
	},
	"keywords": [],
	"author": "Moritz Jung",
	"license": "GPL-3.0",
	"devDependencies": {
		"@happy-dom/global-registrator": "^20.0.11",
		"@lemons_dev/parsinom": "^0.1.0",
		"@sveltejs/vite-plugin-svelte": "7.1.2",
		"@types/bun": "1.3.14",
		"eslint": "9.39.4",
		"eslint-plugin-svelte": "^3.13.1",
		"neat-csv": "^7.0.0",
		"obsidian": "latest",
		"prettier": "3.9.4",
		"prettier-plugin-svelte": "4.1.1",
		"svelte": "5.56.3",
		"svelte-check": "4.6.0",
		"svelteplot": "^0.8.1",
		"tslib": "^2.8.1",
		"typescript": "6.0.3",
		"vite": "8.1.3",
		"@lemons_dev/lemons-obsidian-plugin-automation": "https://github.com/mProjectsCode/lemons-obsidian-plugin-helpers/releases/download/automation-v0.2.9/automation-v0.2.9.tgz",
		"@lemons_dev/eslint-config-obsidian": "https://github.com/mProjectsCode/lemons-obsidian-plugin-helpers/releases/download/eslint-config-v0.1.5/eslint-config-v0.1.5.tgz",
		"@types/node": "25.5.0"
	},
	"packageManager": "bun@1.4.0",
	"overrides": {
		"typescript": "6.0.3",
		"typescript-eslint": "8.61.1"
	}
}
